# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# typescript incremental build cache
*.tsbuildinfo
next-env.d.ts

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.yarnrc
.yarn/releases/yarn-1.22.22.cjs

# Claude Code — per-user settings (permissions, prefs). Shared files
# in .claude/ (launch.json, agents, workflows) stay tracked.
.claude/settings.local.json
.vercel
.env*

# Editor swap/backup files. A Vim swap file of .env.local was committed
# once (June 2026) and is still in the repo's history — `.env*` above
# covers that exact name now, but a swap file of any OTHER file would
# still slip through without this.
*.swp
*.swo
*~
