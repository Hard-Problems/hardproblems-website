# PostHog analytics configuration. Copy this file to .env.local and fill in
# your real project token. .env.local is gitignored.
#
# Find your project API key (starts with phc_) in your PostHog project at:
#   Settings → Project → Project API Key
#
# This project uses a reverse proxy: events are sent to /ingest/* which is
# rewritten in next.config.ts to PostHog's hosts. To bypass the proxy (e.g.,
# debugging), set NEXT_PUBLIC_POSTHOG_HOST to the direct PostHog host such as
# https://eu.i.posthog.com or https://us.i.posthog.com.

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# ---------------------------------------------------------------------
# Google Sheets access — reads the jobs spreadsheet.
#
# Required for /api/cron/sync-jobs. There is no unauthenticated path: the
# public CSV export has been removed, so without these the sync fails and
# the board keeps serving the last snapshot it wrote.
#
# None of these are secret. Authentication is Workload Identity
# Federation: Vercel mints a short-lived OIDC token for the running
# function and Google exchanges it for one that impersonates the service
# account, so there is no key to store or rotate. Setup:
# https://vercel.com/docs/oidc/gcp
#
#   1. Google Cloud -> enable the Google Sheets API.
#   2. IAM & Admin -> Workload Identity Federation -> Create Pool.
#   3. Add an OpenID Connect provider to the pool:
#        Issuer URL: https://oidc.vercel.com/hard-problems
#        JWK file:   leave empty
#        Audience:   Allowed audiences -> https://vercel.com/hard-problems
#        Attribute mapping: google.subject = assertion.sub
#   4. Create a service account, then grant the pool principal
#      roles/iam.workloadIdentityUser on it, with the subject pinned to
#      this project and environment:
#        principal://iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/vercel/subject/owner:hard-problems:project:hardproblems-website:environment:production
#   5. Share the sheet with the service account's address as Viewer.
#   6. Deploy, confirm a cron run succeeds, and ONLY THEN set the
#      sheet's general access to Restricted.
#
# These only work inside a Vercel deployment — the OIDC token does not
# exist on a local machine. Local development reads the Supabase
# snapshot instead and never touches the sheet, so leaving these unset
# locally is fine as long as SUPABASE_URL and SUPABASE_SECRET_KEY are set.
GCP_PROJECT_NUMBER=1234567890
GCP_SERVICE_ACCOUNT_EMAIL=vercel@your-project-123456.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
